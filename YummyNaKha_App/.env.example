# Copy to .env and fill in. Never commit .env. None of these are exposed to the
# browser (no NEXT_PUBLIC_ prefix) — they are read only by server code.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yummynakha?schema=public"

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Used to sign session tokens in cookies.
AUTH_SECRET=

# Our own OCR service (ocr-service/, PaddleOCR) — start it with `npm run ocr`.
# Runs on this machine; no API key and no third-party AI provider.
OCR_SERVICE_URL=http://127.0.0.1:8765

# Public address of the app, no trailing slash. Needed in production for the
# Google sign-in redirect URL; localhost works without it.
APP_URL=

# Google sign-in (optional). Create an OAuth client ID (type "Web application")
# in Google Cloud Console → APIs & Services → Credentials, and add the
# authorized redirect URI  <APP_URL>/api/auth/google/callback
# (for local development: http://localhost:3000/api/auth/google/callback).
# Without these, the "Continue with Google" button shows a friendly message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Menu helper: Google Gemini pairs a menu's dishes with its separate
# meat list (only with the user's "Menu helper" consent; only menu text is sent).
# Without a key the app shows a "choose your meat" list instead.
GEMINI_API_KEY=
# Tried in order; the fastest model you have access to should come first.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
