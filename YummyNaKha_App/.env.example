# Copy to .env and fill in. Never commit .env. None of these are exposed to the
# browser (no NEXT_PUBLIC_ prefix) — they are read only by server code.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yummynakha?schema=public"

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Used to sign session tokens in cookies.
AUTH_SECRET=

# Who reads + translates menu photos: "huggingface" (needs Inference credits)
# or "gemini" (uses GEMINI_API_KEY, works on the free tier). Restart the server after changing.
OCR_PROVIDER=huggingface

# Hugging Face Inference Providers token (fine-grained, "Make calls to Inference Providers").
HUGGINGFACE_API_KEY=
# Vision-language model used to read (OCR) the Thai menu photo.
HUGGINGFACE_MODEL=Qwen/Qwen3.8-27B
# Model used to translate the extracted Thai text into English (chat model).
HUGGINGFACE_TRANSLATION_MODEL=Qwen/Qwen3.8-27B

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when GEMINI_MODEL is overloaded, rate-limited or unavailable (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
