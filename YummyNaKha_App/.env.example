# Copy to .env and fill in. Never commit .env. None of these are exposed to the
# browser (no NEXT_PUBLIC_ prefix) — they are read only by server code.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/yummynakha?schema=public"

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Used to sign session tokens in cookies.
AUTH_SECRET=

# Our own OCR service (ocr-service/, PaddleOCR) — start it with `npm run ocr`.
# Runs on this machine; no API key and no third-party AI provider.
OCR_SERVICE_URL=http://127.0.0.1:8765
