# Copy to .env.production on the server and fill in. Never commit the real file.

# The server's address, without https:// — e.g. yummynakha.southeastasia.cloudapp.azure.com
APP_DOMAIN=

# Database password. Letters and digits only, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login sessions. At least 32 characters, e.g.: openssl rand -base64 48
AUTH_SECRET=

# Google sign-in (optional). Add this redirect URI to the Google OAuth client:
#   https://<APP_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Menu helper (Google Gemini). Leave empty to turn it off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
